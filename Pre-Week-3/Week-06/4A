# Steps 10-11: Basic read
f = open('about_me.txt', 'r')
print(f.read())
f.close()

# Step 12: read(50)
f = open('about_me.txt', 'r')
print(f.read(50))   # first 50 chars
print(f.read(50))   # next 50 chars — cursor advances!
f.close()

# Step 13: readline experiments
f = open('about_me.txt', 'r')
print(f.readline(10))   # first 10 chars of line 1
print(f.readline())     # rest of line 1 / line 2

for i in range(1, 5):
    print(f.readline())
f.close()

# Step 14: readlines experiments
f = open('about_me.txt', 'r')
print(f.readlines(1))    # returns list of 1 line
print(f.readlines(1))    # next line
print(f.readlines(10))   # up to 10 bytes worth
print(f.readlines(100))  # up to 100 bytes
f.close()

# Step 15-16: three variables
f = open('about_me.txt', 'r')
first_50 = f.read(50)

lines_list = []
for line in f:
    lines_list.append(line)

f.close()

f = open('about_me.txt', 'r')
next_100_lines = f.readlines(100)
f.close()

print(f"First 50 characters: {first_50}")
print(f"Next four lines, as list by line: {lines_list[:4]}")
print(f"Next 100 characters, as list by line, rounded up to complete lines: {next_100_lines}")
